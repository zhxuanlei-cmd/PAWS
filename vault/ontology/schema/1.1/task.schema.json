{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paws.local/schema/1.1/task.schema.json",
  "type": "object",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/common"},
    {
      "type": "object",
      "required": [
        "task_id",
        "title",
        "task_state",
        "generation",
        "based_on",
        "branch",
        "worktree_key",
        "write_scope",
        "required_gates",
        "next_action",
        "claim",
        "links"
      ],
      "properties": {
        "type": {"const": "task"},
        "task_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}-[0-9]{8}-[0-9]{3}$"
        },
        "title": {"type": "string", "minLength": 1},
        "task_state": {
          "enum": [
            "planned",
            "implementing",
            "verifying",
            "reviewing",
            "blocked",
            "paused",
            "done",
            "cancelled",
            "superseded"
          ]
        },
        "generation": {"type": "integer", "minimum": 1},
        "based_on": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "worktree_key": {"type": "string", "minLength": 1},
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/relativePath"}
        },
        "required_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "next_action": {"type": "string", "minLength": 1},
        "blocker": {"type": ["string", "null"]},
        "claim": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common.schema.json#/$defs/claim"}
          ]
        },
        "links": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "common.schema.json#/$defs/link"}
        },
        "migration_source_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
