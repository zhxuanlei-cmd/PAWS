{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paws.local/schema/1.1/common.schema.json",
  "$defs": {
    "common": {
      "type": "object",
      "required": [
        "schema_version",
        "type",
        "project",
        "status",
        "created",
        "updated",
        "source",
        "draft"
      ],
      "properties": {
        "schema_version": {"const": "1.1"},
        "type": {"type": "string"},
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "status": {
          "enum": ["active", "paused", "done", "archived", "draft"]
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source": {"type": "string", "minLength": 1},
        "draft": {"type": "boolean"},
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "last_action_id": {
          "type": "string",
          "pattern": "^ACT-[0-9]{8}-[0-9]{3,}$"
        },
        "shadow": {"type": "boolean"}
      }
    },
    "link": {
      "type": "object",
      "required": ["rel", "target"],
      "properties": {
        "rel": {
          "enum": [
            "changes",
            "depends_on",
            "governed_by",
            "evidence_for",
            "observed_repo",
            "supersedes"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^(task|evidence|repo|policy):\\S+$"
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "actor",
        "harness",
        "device_id",
        "generation",
        "worktree_key",
        "acquired_at"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^CLM-[0-9]{8}-[0-9]{3,}$"
        },
        "actor": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "device_id": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 1},
        "worktree_key": {"type": "string", "minLength": 1},
        "acquired_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "spec_version",
        "cwd_relative",
        "command_argv",
        "input_globs",
        "environment_probes"
      ],
      "properties": {
        "spec_version": {"type": "integer", "minimum": 1},
        "cwd_relative": {"$ref": "#/$defs/relativePath"},
        "command_argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "input_globs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "environment_probes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "point_in_time": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
